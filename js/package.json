{
  "name": "@instatus/otel",
  "version": "0.1.0",
  "description": "Instatus error tracking for the web, Node and React Native: an OpenTelemetry distro with a Sentry-compatible API",
  "keywords": [
    "opentelemetry",
    "otel",
    "error-tracking",
    "sentry",
    "tracing",
    "instatus",
    "browser",
    "node",
    "react",
    "react-native"
  ],
  "homepage": "https://github.com/instatushq/otel/tree/main/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instatushq/otel.git",
    "directory": "js"
  },
  "bugs": "https://github.com/instatushq/otel/issues",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/types/browser/index.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./browser/tracing": {
      "types": "./dist/types/tracing/index.d.ts",
      "import": "./dist/browser-tracing.js",
      "require": "./dist/browser-tracing.cjs"
    },
    "./node": {
      "types": "./dist/types/node/index.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./react-native": {
      "types": "./dist/types/react-native/index.d.ts",
      "import": "./dist/react-native.js",
      "require": "./dist/react-native.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "size": "node scripts/size.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-fetch": "^0.301.2",
    "@opentelemetry/instrumentation-xml-http-request": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1"
  },
  "peerDependencies": {
    "@sentry/react-native": ">=8",
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "@sentry/react-native": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/react-native": "^8.36.0",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.2",
    "react": "^19.2.5",
    "typescript": "^6.0.2",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
