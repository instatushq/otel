{
    "name": "instatus/otel",
    "description": "Errors, logs and traces for PHP on OpenTelemetry, with the Sentry SDK's API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["opentelemetry", "otel", "otlp", "error-tracking", "errors", "logging", "tracing", "sentry", "psr-3", "monolog", "instatus"],
    "homepage": "https://github.com/instatushq/otel",
    "authors": [
        {
            "name": "Instatus",
            "homepage": "https://instatus.com"
        }
    ],
    "support": {
        "issues": "https://github.com/instatushq/otel/issues",
        "source": "https://github.com/instatushq/otel"
    },
    "require": {
        "php": ">=8.1",
        "open-telemetry/api": "^1.10",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/sdk": "^1.15",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "An HTTP client for the OTLP exporter, if your app has no PSR-18 client yet",
        "monolog/monolog": "For Instatus\\Logging\\MonologHandler",
        "ext-protobuf": "Faster OTLP encoding than the pure PHP protobuf library"
    },
    "autoload": {
        "psr-4": {
            "Instatus\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Instatus\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "tbachert/spi": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
